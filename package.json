{
  "name": "resonix",
  "version": "1.0.0",
  "description": "High-fidelity self-hosted audio streaming server, Subsonic API backend & audiophile web player with Web Audio DSP, real-time 60fps canvas visualizers, and PWA offline storage",
  "author": "Angki",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Angki/resonix.git"
  },
  "bugs": {
    "url": "https://github.com/Angki/resonix/issues"
  },
  "homepage": "https://github.com/Angki/resonix#readme",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"red,cyan\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:client && node scripts/copy-client.js && npm run build:server",
    "start": "node server/dist/index.js",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:clean-metadata": "tsx server/src/scripts/clean_metadata.ts",
    "db:clean-metadata:dry": "tsx server/src/scripts/clean_metadata.ts --dry-run",
    "db:backfill-replaygain": "npm run db:backfill-replaygain --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
