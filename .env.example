# ==============================================================================
# SERVER NETWORK & SYSTEM CONFIGURATION
# ==============================================================================
HOST=127.0.0.1
PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
DEPLOYMENT_PROFILE=PERSONAL # Options: PERSONAL, LAN, PUBLIC
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# DATABASE & SECURITY SECRETS
# ==============================================================================
DATABASE_URL=file:./data/library.db

# Generate with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
CREDENTIAL_ENCRYPTION_KEY=change-this-to-a-secure-32-byte-hex-or-base64-key

# ==============================================================================
# MUSIC LIBRARY DIRECTORIES
# ==============================================================================
# JSON array of absolute or relative directories containing your music files
LIBRARY_ROOTS_JSON=["C:/Music", "D:/Audio/Lossless"]

# Directory where playlists (.m3u, .mbp) or external library artifacts reside
PLAYLIST_IMPORT_PATH=./data/playlists

# Path to custom ffmpeg binary (leave empty to use system PATH or bundled ffmpeg)
FFMPEG_PATH=

# ==============================================================================
# METADATA & INTEGRATIONS (OPTIONAL)
# ==============================================================================
# Last.fm API credentials (for Scrobbling & Artist Biography sync)
LASTFM_API_KEY=
LASTFM_API_SECRET=
LASTFM_USERNAME=
LASTFM_PASSWORD=
LASTFM_SESSION_KEY=

# Discogs API tokens (for Artist Artwork & Discography metadata)
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
