    "@fastify/static": "^10.1.6",
    "@prisma/client": "^6.4.1",
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "music-metadata": "^10.8.2",
    "p-limit": "^6.2.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
